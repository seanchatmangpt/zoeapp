# ============================================================
# conformance-ledger.ttl — Boundary Conformance Records
# Authority: Process Intelligence Research Foundry
# Date: 2026-06-01
# ============================================================

<https://process.intelligence/ontology/conformance-ledger>
    a owl:Ontology ;
    owl:imports <https://process.intelligence/ontology/pi-program> ;
    dcterms:title "PI Program Conformance Ledger" ;
    dcterms:description "Ledger of boundary conformance records: admission gates, refusal covenants, receipt minting surfaces, replay mechanisms, and conformance verdicts across all PI program systems." ;
    dcterms:created "2026-06-01"^^xsd:date ;
    dcterms:creator <https://process.intelligence/agent/research-foundry> ;
    owl:versionInfo "1.0.0" .

# ============================================================
# SECTION 1: Conformance Record Properties
# ============================================================

pi:ConformanceRecord
    a owl:Class ;
    rdfs:label "Conformance Record" ;
    skos:definition "A structured record documenting the result of comparing a process model against event log evidence, with fitness/precision metrics and a cryptographic receipt." .

pi:fitnessValue
    a owl:DatatypeProperty ;
    rdfs:label "fitness value" ;
    rdfs:domain pi:ConformanceRecord ;
    rdfs:range xsd:decimal ;
    skos:definition "Token-replay or alignment fitness, bounded [0.0, 1.0]. Board-admissible threshold: 0.95. Elastic repair threshold: 0.85. Below 0.85: compliance deviation (lockdown)." .

pi:precisionValue
    a owl:DatatypeProperty ;
    rdfs:label "precision value" ;
    rdfs:domain pi:ConformanceRecord ;
    rdfs:range xsd:decimal ;
    skos:definition "Process model precision, bounded [0.0, 1.0]. Board-admissible threshold: 0.90." .

pi:conformanceVerdict
    a owl:DatatypeProperty ;
    rdfs:label "conformance verdict" ;
    rdfs:domain pi:ConformanceRecord ;
    rdfs:range xsd:string ;
    skos:definition "The verdict of conformance checking: FullyConforming, PartiallyConforming, NonConforming." .

pi:receiptHash
    a owl:DatatypeProperty ;
    rdfs:label "receipt hash" ;
    rdfs:range xsd:string ;
    skos:definition "BLAKE3 hex digest of the conformance receipt. 256-bit (64 hex characters)." .

pi:witnessMarker
    a owl:DatatypeProperty ;
    rdfs:label "witness marker" ;
    rdfs:range xsd:string ;
    skos:definition "The zero-cost witness type that sealed this conformance record (e.g., InductiveWitness, AlphaWitness, WitnessState, Ocel20)." .

pi:alignmentCost
    a owl:DatatypeProperty ;
    rdfs:label "alignment cost" ;
    rdfs:domain pi:ConformanceRecord ;
    rdfs:range xsd:integer ;
    skos:definition "Total alignment cost: log moves + model moves. Synchronous moves cost 0." .

# ============================================================
# SECTION 2: Boundary Conformance Surfaces
# ============================================================

conf:otel-to-ocel-boundary
    a prov:Entity, pi:CONFORMANCE_SURFACE ;
    rdfs:label "OTel-to-OCEL Projection Boundary" ;
    dcterms:description "Projection: OtelSpanToOcelEventProjection (witness marker). TraceID→CaseCorrelationID, SpanID→EventTransactionID, SpanName→ActivityLabel, StartTime/EndTime→StartEndTimestamp. Loss policy: OtelToOcelLossPolicy. Nanosecond→microsecond truncation documented. Resource scope collapse documented. Causality degradation (async spans) documented. LossReport generated at every projection." ;
    prov:wasPartOf proj:otel-weaver ;
    pi:witnessMarker "OtelSpanToOcelEventProjection" .

conf:wasm4pm-token-replay-conformance
    a prov:Entity, pi:CONFORMANCE_SURFACE ;
    rdfs:label "wasm4pm Token Replay Conformance" ;
    dcterms:description "Token replay conformance surface in wasm4pm. Surface: token_replay_conformance(net, event_log). Fitness = 1.0 - (alignment_cost / (log_length * 2)). ConformanceVerdict: FullyConforming (fitness=1.0), PartiallyConforming{fitness, deviations}, NonConforming{reason}. ConformanceVerdicts aggregator: aggregate_fitness, aggregate_precision, admission_rate." ;
    prov:wasPartOf proj:wasm4pm ;
    pi:fitnessValue "1.0"^^xsd:decimal ;
    skos:note "alignment-based conformance (stub, conformance_boundary=false) not graduated" .

conf:blue-river-conformance
    a prov:Entity, pi:CONFORMANCE_SURFACE ;
    rdfs:label "Blue River Dam MAPE-K Conformance" ;
    dcterms:description "Blue River Dam Auditor::compute_fitness (LCS-based). ConformanceMetric{fitness, trace_id, alignment_moves, threshold}. Thresholds: >= 0.95 (within bounds), 0.85-0.95 (WarningDeviation→elastic repair), < 0.85 (CriticalDeviation→lockdown+escalation). Gate 3: admissible(σ) ≡ fitness >= 0.95 ∨ (fitness >= 0.85 ∧ override_signed)." ;
    prov:wasPartOf proj:blue-river-dam ;
    pi:conformanceThreshold "0.95"^^xsd:decimal .

conf:ggen-board-admissible-gate
    a prov:Entity, pi:CONFORMANCE_SURFACE ;
    rdfs:label "ggen Board-Admissible Conformance Gate" ;
    dcterms:description "Board-admissible conformance gate in ggen primary cell. SPARQL filter: FILTER (?verdictFitness >= 0.95 && ?verdictPrecision >= 0.90). Template gate: ma-deck.tera line 55 ADMISSIBLE/REJECTED status. Ontology gate: ma:backedBy requires owl:minCardinality 1 ConformanceVerdict." ;
    prov:wasPartOf proj:ggen-primary-cell ;
    pi:fitnessValue "0.95"^^xsd:decimal ;
    pi:precisionValue "0.90"^^xsd:decimal .

conf:compat-fitness-type-law
    a prov:Entity, pi:CONFORMANCE_SURFACE ;
    rdfs:label "wasm4pm-compat Fitness Type-Law Surface" ;
    dcterms:description "Compile-time bounded [0,1] metrics in wasm4pm-compat. FitnessConst<NUM, DEN>: compiles only when NUM/DEN ∈ [0,1]. FitnessConst<3,4>=0.75 compiles. FitnessConst<2,1>=2.0 does NOT compile. Between01<NUM, DEN> nightly const_trait_impl enforcement. No runtime computation — shape only." ;
    prov:wasPartOf proj:wasm4pm-compat ;
    skos:note "wasm4pm-compat carries conformance shapes but never computes them. Execution graduates to wasm4pm ENGINE." .

conf:zoeapp-ocel-conformance
    a prov:Entity, pi:CONFORMANCE_SURFACE ;
    rdfs:label "ZOEapp OCEL 2.0 Conformance" ;
    dcterms:description "ZOEapp OCEL 2.0 conformance via truex-hook-replay Edge Function. Verification: batchValid (SHA256 ocel2 batch hash == expected_path_hash), receiptValid (BLAKE3 receipt_hash == expected), verified (both). 516 replay fixtures. Sample OCEL event: {activity: PublishSermon, timestamp: 2026-05-23T10:00:00Z, object: sermon-1, type: CreativeWork}." ;
    prov:wasPartOf proj:zoeapp ;
    pi:conformanceVerdict "VERIFIED" .

# ============================================================
# SECTION 3: Receipt Records (Cryptographic Proof Surfaces)
# ============================================================

conf:wasm4pm-receipt-minting
    a prov:Entity, pi:RECEIPT_SURFACE ;
    rdfs:label "wasm4pm Receipt Minting" ;
    dcterms:description "ReplayModuleReceipt::mint(artifact_hash, witness_marker, previous_receipt). OtelSpan.blake3_receipt: hex-encoded Blake3 hash per span step. OtelTrace.event_chain_root: final span's Blake3 receipt. Evidence<T, State, W>.hash: Blake3Hash([u8; 32]) over (payload, state, witness, epoch, signature). IdentitySignature: 32-byte Ed25519 pubkey + 64-byte signature." ;
    prov:wasPartOf proj:wasm4pm .

conf:blue-river-receipt-chain
    a prov:Entity, pi:RECEIPT_SURFACE ;
    rdfs:label "Blue River Dam Governance Receipt Chain" ;
    dcterms:description "SHA-256 block-chained governance ledger. Every action produces Receipt{action_id: u64, timestamp: u64, outcome: ActionOutcome}. Decommissioning magic: 0xDEC0FFEE. Ledger entry: {block_index, timestamp, entry_type, evidence, block_hash, prev_block_hash, authority_signature(Ed25519)}. Tamper-evident: hash chain breaks on modification." ;
    prov:wasPartOf proj:blue-river-dam .

conf:zoeapp-blake3-receipts
    a prov:Entity, pi:RECEIPT_SURFACE ;
    rdfs:label "ZOEapp BLAKE3 Receipt Chain" ;
    dcterms:description "ZOEapp receipt chain: actor_receipts Supabase table + BLAKE3 verification. 3-tier storage fallback: Zustand latestReceipt → MMKV → SQLite (drizzle-orm). truex-verify Edge Function: BLAKE3 receipt hash verification. PremiumReceiptBlockingScreen: displays command_id, expected delta_hash, signature verification badge, refusal reason code." ;
    prov:wasPartOf proj:zoeapp .

conf:ma-receipt-chain
    a prov:Entity, pi:RECEIPT_SURFACE ;
    rdfs:label "M&A Cryptographic Receipt Chain" ;
    dcterms:description "Board-admissible M&A receipts: Ed25519-signed fitness/precision/EBITDA impact tuples. Sample: rec_ebitda_rework_001.json — fitness=0.982, precision=0.945, ebitda_impact=$1,250,000. validator_signature: ed25519_sig_8a3e811c_02e0df2f... Verification chain: hash_log, hash_model, execute_conformance_wasm4pm, measure_fitness, calculate_ebitda, sign_ed25519, store_BLAKE3_chain." ;
    prov:wasPartOf <https://process.intelligence/phase/6-ma-claim-taxonomy> .

# ============================================================
# SECTION 4: Admission/Refusal Covenant Records
# ============================================================

conf:compat-one-way-door
    a prov:Entity, pi:ADMISSION_SURFACE ;
    rdfs:label "wasm4pm-compat One-Way Door" ;
    dcterms:description "Type-level one-way lifecycle in wasm4pm-compat. Raw→Parsed→Admitted→{Projected|Exportable|Receipted}. Evidence<T, Raw, W> and Evidence<T, Admitted, W> are different types — compiler enforces at zero runtime cost. No function accepting Admitted can accept Raw. Refused: immutable Refusal<R, W> terminal state carrying named law." ;
    prov:wasPartOf proj:wasm4pm-compat .

conf:wasm4pm-11-pathway-admission
    a prov:Entity, pi:ADMISSION_SURFACE ;
    rdfs:label "wasm4pm 11-Pathway Admission Law (via Blue River)" ;
    dcterms:description "11 admission pathways in Blue River Dam: (1) temporal monotonicity, (2) schema type match, (3) causal object reference resolution, (4) memory bounds, (5) Ed25519 signature valid, (6) Petri net soundness, (7) fitness >= 0.85, (8) object identity not contradictory, (9) BPMN OR-join quorum defined, (10) Declare constraints absent, (11) event IDs unique. Default: DENY." ;
    prov:wasPartOf proj:blue-river-dam .

conf:otel-feedstock-admission
    a prov:Entity, pi:ADMISSION_SURFACE ;
    rdfs:label "OTel Weaver Feedstock Admission" ;
    dcterms:description "OTel feedstock admission: schema URL present → receipt context resolved. violation_halt refusals rejected. escalation_warning admitted with quarantine flag. Admitted feedstock wrapped in Admission<T, OtelSpanToOcelEventProjection>. LossReport mandatory for every projection (truncation, scope collapse, causality degradation)." ;
    prov:wasPartOf proj:otel-weaver .

# ============================================================
# SECTION 5: Replay Conformance Records
# ============================================================

conf:wasm4pm-replay-engine
    a prov:Entity, pi:REPLAY_SURFACE ;
    rdfs:label "wasm4pm ReplayEngine" ;
    dcterms:description "ReplayEngine: multi-path token game replay over event log. Synchronous moves (cost=0), log moves (cost=1), model moves (cost=1). WitnessState: PartialReplay{trace_indices, marking, cost}. Best path selection by minimum cost. fitness: 1 - (alignment_cost / (log_length * 2)). OtelSpan emitted per step with BLAKE3 receipt." ;
    prov:wasPartOf proj:wasm4pm .

conf:wasm4pm-step-simulator
    a prov:Entity, pi:REPLAY_SURFACE ;
    rdfs:label "wasm4pm StepSimulator" ;
    dcterms:description "StepSimulator: interactive one-step-at-a-time execution. enabled_activities() lists enabled transitions at current Marking. step(activity) fires named transition. Each step emits OtelSpan{span_id, parent_span_id, span_name, start/end_time, instruction_count, blake3_receipt}. reset() returns to initial marking. history() inspects all executed steps." ;
    prov:wasPartOf proj:wasm4pm .

conf:zoeapp-truex-replay
    a prov:Entity, pi:REPLAY_SURFACE ;
    rdfs:label "ZOEapp truex-hook-replay" ;
    dcterms:description "Deterministic replay verification in ZOEapp Edge Function. Input: {history, messages, initialState}. Output: {verified, proof, messageCount}. Verifies batch hash == expected_path_hash (SHA256) and receipt hash == expected (BLAKE3). 516 fixture scenarios verified." ;
    prov:wasPartOf proj:zoeapp .

# ============================================================
# SECTION 6: SHACL Constraints
# ============================================================

pi:ConformanceRecordShape
    a sh:NodeShape ;
    sh:targetClass pi:ConformanceRecord ;
    sh:property [
        sh:path pi:fitnessValue ;
        sh:minCount 1 ;
        sh:minInclusive 0.0 ;
        sh:maxInclusive 1.0 ;
        sh:datatype xsd:decimal ;
        sh:message "Conformance records must have a fitness value bounded [0.0, 1.0]." ;
    ] ;
    sh:property [
        sh:path pi:conformanceVerdict ;
        sh:minCount 1 ;
        sh:in ("FullyConforming" "PartiallyConforming" "NonConforming" "VERIFIED" "FAILED") ;
        sh:message "Conformance verdict must be one of the defined verdict types." ;
    ] .

pi:ReceiptSurfaceShape
    a sh:NodeShape ;
    sh:targetClass pi:RECEIPT_SURFACE ;
    sh:property [
        sh:path pi:witnessMarker ;
        sh:minCount 1 ;
        sh:message "Receipt surfaces must name the witness marker sealing the proof." ;
    ] .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix schema:  <https://schema.org/> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix pi:      <https://process.intelligence/ontology/> .
@prefix grad:    <https://process.intelligence/graduation/> .
@prefix proj:    <https://process.intelligence/project/> .

# ============================================================
# graduation-boundary.ttl — Graduation Signals and Reasons
# Authority: Process Intelligence Research Foundry
# Date: 2026-06-01
# Doctrine: No compat execution. No engine in compat.
#   All execution MUST graduate to wasm4pm ENGINE.
# ============================================================

<https://process.intelligence/ontology/graduation-boundary>
    a owl:Ontology ;
    owl:imports <https://process.intelligence/ontology/pi-program> ;
    dcterms:title "PI Program Graduation Boundary Ontology" ;
    dcterms:description "Defines the graduation boundary between the COMPATIBILITY_LAYER (wasm4pm-compat) and the ENGINE (wasm4pm). Every process execution capability must graduate to the ENGINE — the COMPATIBILITY_LAYER carries structure only." ;
    dcterms:created "2026-06-01"^^xsd:date ;
    dcterms:creator <https://process.intelligence/agent/research-foundry> ;
    owl:versionInfo "1.0.0" ;
    skos:editorialNote "Doctrine: HiddenProcessMiningGrowth is the tripwire. If a boundary declaration claims discovery/conformance/replay execution, strict mode refuses and points to wasm4pm graduation." .

# ============================================================
# SECTION 1: Graduation Signal Classes
# ============================================================

pi:GraduationReason
    a owl:Class ;
    rdfs:label "Graduation Reason" ;
    skos:definition "A hard signal from the COMPATIBILITY_LAYER declaring that execution capability is required and must be delegated to the wasm4pm ENGINE." .

pi:NeedsDiscovery
    a owl:Class ;
    rdfs:subClassOf pi:GraduationReason ;
    rdfs:label "NeedsDiscovery" ;
    skos:definition "The host has a raw event log and no process model. Discovery algorithm execution required. Graduate to wasm4pm inductive_miner, heuristics_miner, alpha_miner, or dfg_mining." .

pi:NeedsConformanceExecution
    a owl:Class ;
    rdfs:subClassOf pi:GraduationReason ;
    rdfs:label "NeedsConformanceExecution" ;
    skos:definition "A conformance verdict must be computed, not carried. Graduate to wasm4pm token_replay_conformance. Fitness/precision values must be measured, not assumed." .

pi:NeedsReplay
    a owl:Class ;
    rdfs:subClassOf pi:GraduationReason ;
    rdfs:label "NeedsReplay" ;
    skos:definition "Replay must be executed, not assumed. Graduate to wasm4pm ReplayEngine or StepSimulator for token game execution and OtelSpan generation." .

pi:NeedsObjectCentricQueryExecution
    a owl:Class ;
    rdfs:subClassOf pi:GraduationReason ;
    rdfs:label "NeedsObjectCentricQueryExecution" ;
    skos:definition "OCPQ (Object-Centric Process Query) must be executed. Graduate to wasm4pm execute_ocpq_query with gas metering and recursion protection." .

pi:RebuildingProcessMiningLocally
    a owl:Class ;
    rdfs:subClassOf pi:GraduationReason ;
    rdfs:label "RebuildingProcessMiningLocally" ;
    skos:definition "CRITICAL SIGNAL. The host is implementing process mining logic locally outside the ENGINE. This must never happen. Strict mode refuses and mandates graduation to wasm4pm." .

# ============================================================
# SECTION 2: Graduation Boundary Properties
# ============================================================

pi:graduationReason
    a owl:ObjectProperty ;
    rdfs:label "graduation reason" ;
    rdfs:domain pi:GRADUATION_SIGNAL ;
    rdfs:range pi:GraduationReason ;
    skos:definition "The specific reason a capability must graduate from COMPATIBILITY_LAYER to ENGINE." .

pi:graduationSubject
    a owl:DatatypeProperty ;
    rdfs:label "graduation subject" ;
    rdfs:domain pi:GRADUATION_SIGNAL ;
    rdfs:range xsd:string ;
    skos:definition "The identifier of the entity that requires graduation (e.g., a log reference, a process model URI)." .

pi:evidenceRef
    a owl:DatatypeProperty ;
    rdfs:label "evidence reference" ;
    rdfs:domain pi:GRADUATION_SIGNAL ;
    rdfs:range xsd:string ;
    skos:definition "A Blake3 digest or OCEL pointer identifying the evidence requiring ENGINE execution. Must be verified by wasm4pm before execution." .

pi:graduatesFrom
    a owl:ObjectProperty ;
    rdfs:label "graduates from" ;
    rdfs:domain pi:GRADUATION_SIGNAL ;
    rdfs:range pi:COMPATIBILITY_LAYER ;
    skos:definition "The COMPATIBILITY_LAYER surface from which this graduation signal originates." .

pi:graduatesTo
    a owl:ObjectProperty ;
    rdfs:label "graduates to" ;
    rdfs:domain pi:GRADUATION_SIGNAL ;
    rdfs:range pi:ENGINE ;
    skos:definition "The ENGINE surface to which execution must be delegated." .

pi:engineSurface
    a owl:DatatypeProperty ;
    rdfs:label "engine surface" ;
    rdfs:domain pi:GRADUATION_SIGNAL ;
    rdfs:range xsd:string ;
    skos:definition "The specific wasm4pm function or module that must be invoked (e.g., inductive_miner, token_replay_conformance, execute_ocpq_query)." .

# ============================================================
# SECTION 3: Graduation Signal Instances
# ============================================================

grad:signal-needs-discovery
    a prov:Entity, pi:GRADUATION_SIGNAL ;
    pi:graduationReason pi:NeedsDiscovery ;
    rdfs:label "Graduation Signal: Needs Discovery" ;
    dcterms:description "Trigger: compat host has raw event log with no process model. The host must not implement discovery locally. Graduate to wasm4pm." ;
    pi:graduatesFrom proj:wasm4pm-compat ;
    pi:graduatesTo proj:wasm4pm ;
    pi:engineSurface "inductive_miner(event_log, noise_threshold, public_key, signature) -> Evidence<ProcessTree, Admitted, InductiveWitness>" ;
    skos:example "AwaitingDiscovery { log_ref: blake3:abc123 } → GraduationCandidate { reason: NeedsDiscovery, subject: log_ref, evidence_ref: blake3:abc123 }" .

grad:signal-needs-conformance-execution
    a prov:Entity, pi:GRADUATION_SIGNAL ;
    pi:graduationReason pi:NeedsConformanceExecution ;
    rdfs:label "Graduation Signal: Needs Conformance Execution" ;
    dcterms:description "Trigger: compat host carries ConformanceVerdict shape but must compute fitness/precision. Graduate to wasm4pm token_replay_conformance. compat FitnessConst<NUM,DEN> carries shape only; actual value must come from ENGINE." ;
    pi:graduatesFrom proj:wasm4pm-compat ;
    pi:graduatesTo proj:wasm4pm ;
    pi:engineSurface "token_replay_conformance(net, event_log) -> ConformanceVerdict{FullyConforming|PartiallyConforming{fitness,deviations}|NonConforming{reason}}" .

grad:signal-needs-replay
    a prov:Entity, pi:GRADUATION_SIGNAL ;
    pi:graduationReason pi:NeedsReplay ;
    rdfs:label "Graduation Signal: Needs Replay" ;
    dcterms:description "Trigger: compat host carries receipt digest/replay-hint shapes but must execute replay. Graduate to wasm4pm ReplayEngine. compat Digest(String) and ReplayHint(String) carry shapes only; WellShaped checks presence not authenticity." ;
    pi:graduatesFrom proj:wasm4pm-compat ;
    pi:graduatesTo proj:wasm4pm ;
    pi:engineSurface "ReplayEngine::new(net, event_log).replay() -> Evidence<ReplayTraces, (), WitnessState>" .

grad:signal-needs-ocpq
    a prov:Entity, pi:GRADUATION_SIGNAL ;
    pi:graduationReason pi:NeedsObjectCentricQueryExecution ;
    rdfs:label "Graduation Signal: Needs OCPQ Execution" ;
    dcterms:description "Trigger: compat host names OCPQ query shape but must execute it. Graduate to wasm4pm execute_ocpq_query with O2E inverted index, gas metering (50 cycles/event evaluation, 30 cycles/object traversal), and recursion guard." ;
    pi:graduatesFrom proj:wasm4pm-compat ;
    pi:graduatesTo proj:wasm4pm ;
    pi:engineSurface "execute_ocpq_query(ocel, query, gas_meter, recursion_guard) -> QueryResult{match_count, matches: Vec<OcpqMatch{event_1_id, event_2_id, object_id, duration_us}>}" .

grad:signal-hidden-pm-growth
    a prov:Entity, pi:GRADUATION_SIGNAL ;
    pi:graduationReason pi:RebuildingProcessMiningLocally ;
    rdfs:label "Graduation Signal: Hidden Process Mining Growth" ;
    dcterms:description "CRITICAL TRIPWIRE. If a ProcessBoundary declaration in wasm4pm-compat claims process mining execution (discovery/conformance/replay) AND hidden_pm_growth=true, strict mode emits HiddenProcessMiningGrowth StrictViolation. Remediation: graduate to wasm4pm immediately. This is the primary enforcement mechanism preventing compat from becoming an engine." ;
    pi:graduatesFrom proj:wasm4pm-compat ;
    pi:graduatesTo proj:wasm4pm ;
    pi:engineSurface "ALL wasm4pm execution surfaces" .

# ============================================================
# SECTION 4: Boundary Laws
# ============================================================

grad:compat-no-discovery-law
    a prov:Entity ;
    rdfs:label "Law: No Discovery in compat" ;
    dcterms:description "Forbidden: Any discovery algorithm anywhere in wasm4pm-compat/src/. Permitted: Pm4pyShape::ProcessTree and SummaryShape::TraceVariants as shape descriptors (names only, never computed values). Graduation: Use wasm4pm inductive_miner or heuristics_miner for actual discovery." ;
    prov:wasPartOf proj:wasm4pm-compat .

grad:compat-no-replay-law
    a prov:Entity ;
    rdfs:label "Law: No Replay in compat" ;
    dcterms:description "Forbidden: Token-replay engine or alignment computation in wasm4pm-compat/src/. Permitted: conformance.rs provides ConformanceVerdict carriers with bounded metrics (FitnessConst<NUM,DEN>) but never computes them. Graduation: Real fitness computation in wasm4pm." ;
    prov:wasPartOf proj:wasm4pm-compat .

grad:compat-no-ocpq-law
    a prov:Entity ;
    rdfs:label "Law: No OCPQ in compat" ;
    dcterms:description "Forbidden: Query execution in wasm4pm-compat/src/. Permitted: ocpq.rs names the query shape (object type filtering), never executes. Graduation: wasm4pm execute_ocpq_query." ;
    prov:wasPartOf proj:wasm4pm-compat .

grad:compat-no-receipt-computation-law
    a prov:Entity ;
    rdfs:label "Law: No Receipt Computation in compat" ;
    dcterms:description "Forbidden: Hashing, signing, or verification in wasm4pm-compat/src/. Permitted: receipt.rs carries Digest(String) and ReplayHint(String) as transparent strings. WellShaped trait checks structural presence only. Graduation: BLAKE3/Ed25519 cryptography in wasm4pm." ;
    prov:wasPartOf proj:wasm4pm-compat .

grad:compat-no-benchmarking-law
    a prov:Entity ;
    rdfs:label "Law: No Benchmarking in compat" ;
    dcterms:description "Forbidden: Performance benchmark engines in wasm4pm-compat. Permitted: benches/ directory for zero-cost proofs that types are zero-cost abstractions." ;
    prov:wasPartOf proj:wasm4pm-compat .

# ============================================================
# SECTION 5: Graduation WIT World Boundary
# ============================================================

grad:compat-world
    a prov:Entity ;
    rdfs:label "WIT compat-world" ;
    dcterms:description "WebAssembly Interface Types compat-world: structure-only validators. Components: evidence-types (witness catalog, state catalog, structural validation), admission-gate (11 named law checks), refusal-gate (named refusal reasons). No execution permitted." ;
    pi:hasRole pi:COMPATIBILITY_LAYER .

grad:engine-world
    a prov:Entity ;
    rdfs:label "WIT engine-world" ;
    dcterms:description "WebAssembly Interface Types engine-world: execution-allowed (downstream wasm4pm only). Components: discovery, conformance, replay, receipt minting. Doctrine: No raw data laundering between worlds. All engine functions consume evidence certified by compat-world validators." ;
    pi:hasRole pi:ENGINE .

grad:wit-world-boundary-law
    a prov:Entity ;
    rdfs:label "WIT World Boundary Law" ;
    dcterms:description "Immutable boundary between compat-world and engine-world. No function may claim membership in both worlds. No raw data may cross from compat-world to engine-world without Admit certification. Graduation bridge (GraduateToWasm4pm trait) is the only lawful crossing point." ;
    prov:wasPartOf proj:ggen-primary-cell .

# ============================================================
# SECTION 6: SHACL Constraints
# ============================================================

pi:GraduationSignalShape
    a sh:NodeShape ;
    sh:targetClass pi:GRADUATION_SIGNAL ;
    sh:property [
        sh:path pi:graduationReason ;
        sh:minCount 1 ;
        sh:message "Every graduation signal must identify a specific graduation reason." ;
    ] ;
    sh:property [
        sh:path pi:graduatesTo ;
        sh:minCount 1 ;
        sh:message "Every graduation signal must name the ENGINE surface it graduates to." ;
    ] ;
    sh:property [
        sh:path pi:engineSurface ;
        sh:minCount 1 ;
        sh:message "Every graduation signal must specify the wasm4pm engine surface function." ;
    ] .

pi:CompatLayerShape
    a sh:NodeShape ;
    sh:targetClass pi:COMPATIBILITY_LAYER ;
    sh:not [
        sh:property [
            sh:path pi:hasRole ;
            sh:hasValue pi:ENGINE ;
        ]
    ] ;
    sh:message "COMPATIBILITY_LAYER must not be classified as ENGINE — no execution in compat." .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix schema:  <https://schema.org/> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix pi:      <https://process.intelligence/ontology/> .
@prefix fcl:     <https://process.intelligence/forbidden-collapse/> .
@prefix proj:    <https://process.intelligence/project/> .

# ============================================================
# forbidden-collapse-law.ttl — DTO/JSON Boundary Laws
# Authority: Process Intelligence Research Foundry
# Date: 2026-06-01
# Doctrine: JSON flattening of Evidence<T, State, Witness>
#   is a defect, not a discrepancy. Model-vs-log mismatch
#   is a defect. Raw evidence export is a defect.
# ============================================================

<https://process.intelligence/ontology/forbidden-collapse-law>
    a owl:Ontology ;
    owl:imports <https://process.intelligence/ontology/pi-program> ;
    dcterms:title "PI Program Forbidden Collapse Law" ;
    dcterms:description "Defines the laws governing DTO/JSON boundary violations. The typestate of Evidence<T, State, Witness> must not be flattened to untyped JSON. Every collapse loses: (1) lifecycle state enforcement, (2) witness lattice authority, (3) refusal law binding, (4) graduation gate integrity." ;
    dcterms:created "2026-06-01"^^xsd:date ;
    dcterms:creator <https://process.intelligence/agent/research-foundry> ;
    owl:versionInfo "1.0.0" ;
    skos:editorialNote "Van der Aalst Constitution: If the code says it worked but the event log cannot prove a lawful process happened, then it did not work." .

# ============================================================
# SECTION 1: Collapse Category Taxonomy
# ============================================================

pi:CollapseCategory
    a owl:Class ;
    rdfs:label "Collapse Category" ;
    skos:definition "A named category of DTO/JSON boundary violation." .

pi:StateTagCollapse
    a owl:Class ;
    rdfs:subClassOf pi:FORBIDDEN_COLLAPSE ;
    rdfs:label "State Tag Collapse" ;
    skos:definition "EvidenceState serialized as unbounded String rather than sealed enum. Browser can forge 'Raw_Admitted', 'MalformedState', or '' as legitimate state tags." ;
    skos:example "WasmStateTag::name: String — allows any string; should be sealed to 7 canonical values: Raw, Parsed, Admitted, Refused, Projected, Exportable, Receipted." .

pi:RefusalLawCollapse
    a owl:Class ;
    rdfs:subClassOf pi:FORBIDDEN_COLLAPSE ;
    rdfs:label "Refusal Law Collapse" ;
    skos:definition "Refusal law name serialized as unbounded Option<String>. Caller can forge 'AllowAnything', 'SkipValidation', or '' as a legitimate named law." ;
    skos:example "WasmAdmissionResult::refusal_law: Option<String> — should be sealed to named refusal variant enum." .

pi:EvidenceRefCollapse
    a owl:Class ;
    rdfs:subClassOf pi:FORBIDDEN_COLLAPSE ;
    rdfs:label "Evidence Reference Collapse" ;
    skos:definition "Evidence reference serialized as unbounded String. Caller can inject arbitrary URIs, fake digests, or control characters as evidence references." ;
    skos:example "WasmGraduationCandidate::evidence_ref: String — should be validated as a Blake3 digest pattern before acceptance." .

pi:LossItemCollapse
    a owl:Class ;
    rdfs:subClassOf pi:FORBIDDEN_COLLAPSE ;
    rdfs:label "Loss Item Collapse" ;
    skos:definition "Loss report items serialized as Vec<String> with no size limit or schema validation. Caller can construct unbounded vectors or inject negative counts." ;
    skos:example "WasmLossReport::items_dropped: Vec<String> — no size check; create_loss_report() accepts caller-provided Vec." .

pi:WitnessKeyCollapse
    a owl:Class ;
    rdfs:subClassOf pi:FORBIDDEN_COLLAPSE ;
    rdfs:label "Witness Key Collapse" ;
    skos:definition "Witness key serialized as unbounded String. Caller can forge 'unknown-witness', 'no-witness', or '' as a legitimate witness key, bypassing the witness lattice authority." ;
    skos:example "WasmWitness::key: String — should be constrained to canonical witness key values: ocel-2.0, xes-1849-2016, wfnet-soundness, etc." .

pi:JSONSerializationCollapse
    a owl:Class ;
    rdfs:subClassOf pi:FORBIDDEN_COLLAPSE ;
    rdfs:label "JSON Serialization in compat Public API" ;
    skos:definition "A public API function in wasm4pm-compat that returns Evidence<T> serialized to a JSON string, destroying the typestate and losing lifecycle state, witness authority, and refusal binding." ;
    skos:example "pub fn to_json_string(&self) -> String; fn receipt_json(&self) -> String — AUDIT 1 FAIL in GGEN_ECOSYSTEM_INTEL_ALIVE_001." .

pi:SilentFlatteningCollapse
    a owl:Class ;
    rdfs:subClassOf pi:FORBIDDEN_COLLAPSE ;
    rdfs:label "Silent OCEL-to-XES Flattening" ;
    skos:definition "Projecting OCEL 2.0 (object-centric) to XES (case-centric) without: (1) named projection, (2) LossPolicy declaration, and (3) LossReport generation. Silent flattening destroys the object-centric event model." ;
    skos:example "OCEL→XES without ProjectionName 'ocel_to_xes_flattening_on_primary_object' and LossReport {object_object_links: dropped, event_attributes: truncated}." .

pi:RawEvidenceExportCollapse
    a owl:Class ;
    rdfs:subClassOf pi:FORBIDDEN_COLLAPSE ;
    rdfs:label "Raw Evidence Export" ;
    skos:definition "Exporting Evidence<T, Raw, W> directly without passing through the Admit trait. Raw evidence has not been validated and carries no admission authority." ;
    skos:example "Evidence<T, Raw, W>::into_inner() — forbidden. Only Evidence<T, Admitted, W> has export methods." .

pi:WitnessMixingCollapse
    a owl:Class ;
    rdfs:subClassOf pi:FORBIDDEN_COLLAPSE ;
    rdfs:label "Witness Mixing" ;
    skos:definition "Implicit conversion between Admission<T, Ocel20> and Admission<T, Xes1849> without an explicit projection naming the law and carrying a LossReport." ;
    skos:example "let xes_admission: Admission<T, Xes1849> = ocel_admission; — COMPILE FAIL: different witness types are different types." .

# ============================================================
# SECTION 2: Collapse Law Properties
# ============================================================

pi:collapseLocation
    a owl:DatatypeProperty ;
    rdfs:label "collapse location" ;
    rdfs:domain pi:FORBIDDEN_COLLAPSE ;
    rdfs:range xsd:string ;
    skos:definition "File path and line number where the collapse was identified." .

pi:collapseStatus
    a owl:DatatypeProperty ;
    rdfs:label "collapse status" ;
    rdfs:domain pi:FORBIDDEN_COLLAPSE ;
    rdfs:range xsd:string ;
    skos:definition "Current status of the collapse: ACTIVE (present in code), MITIGATED (deferred to engine validation), REMEDIATED (fixed)." .

pi:collapseRemediationPath
    a owl:DatatypeProperty ;
    rdfs:label "collapse remediation path" ;
    rdfs:domain pi:FORBIDDEN_COLLAPSE ;
    rdfs:range xsd:string ;
    skos:definition "The prescribed remediation: remove, replace with sealed enum, add engine-side validation, or graduate to wasm4pm." .

pi:collapseAuditResult
    a owl:DatatypeProperty ;
    rdfs:label "collapse audit result" ;
    rdfs:range xsd:string ;
    skos:definition "The audit gate result for this collapse: PASS (no collapse found), FAIL (collapse found and blocking), MITIGATED (collapse found but deferred)." .

